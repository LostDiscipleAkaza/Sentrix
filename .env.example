# ==============================================================================
# Sentrix - Threat Intelligence & API Credentials Template (.env.example)
# Copy this file to .env and fill in your keys: cp .env.example .env
# ==============================================================================

# 1. NIST National Vulnerability Database (NVD) v2.0 API Key (Free)
# Request at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# 2. CIRCL Vulnerability Lookup API Key (Optional - public API needs no key)
CIRCL_API_KEY=

# 3. Shodan API Key (Optional - internetdb.shodan.io is free and needs no key)
SHODAN_API_KEY=

# 4. Local SQLite Threat Intelligence Cache Database
SENTRIX_CACHE_DB=cve_cache.db
